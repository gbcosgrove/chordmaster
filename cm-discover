def vscode_command_to_description(command_id: str) -> tuple[str, int]:
    """
    Return (description, difficulty) for a VS Code command ID.
    Falls back to parsing the command name into readable text.
    """
    if command_id in VSCODE_DESCRIPTIONS:
        return VSCODE_DESCRIPTIONS[command_id]

    # Fallback: parse command name
    # e.g. "workbench.action.showCommands" → "Show Commands"
    # e.g. "editor.action.formatDocument" → "Format Document"
    parts = command_id.split(".")
    # Find the most meaningful part (skip generic namespaces)
    SKIP = {"workbench", "editor", "action", "view", "files", "terminal", "git"}
    for part in reversed(parts):
        if part.lower() not in SKIP and part:
            # Split camelCase and title-case
            words = re.sub(r"([A-Z])", r" \1", part).strip()
            return (words.title(), 2)

    return (command_id.split(".")[-1].title(), 2)


def _vscode_category(command_id: str) -> str:
    """Derive a category from a VS Code command ID."""
    if "terminal" in command_id:            return "Terminal"
    if "file" in command_id.lower():        return "File"
    if "editor" in command_id:
        if "action.go" in command_id:       return "Navigation"
        if "fold" in command_id:            return "Folding"
        if "comment" in command_id:         return "Editing"
        if "format" in command_id:          return "Editing"
        if "selection" in command_id:       return "Selection"
        if "find" in command_id or "replace" in command_id: return "Search"
        return "Editing"
    if "view" in command_id:                return "View"
    if "find" in command_id or "search" in command_id: return "Search"
    if "navigate" in command_id or "goto" in command_id: return "Navigation"
    if "debug" in command_id:               return "Debug"
    if "scm" in command_id or "git" in command_id: return "Git"
    if "extension" in command_id:           return "Extensions"
    if "problem" in command_id:             return "Problems"
    return "General"


# ── VSCODE — PARSER ──────────────────────────────────────────────────────────

def parse_vscode(config_path: Path) -> dict:
    """
    Parse a VS Code keybindings.json and return a chordmaster keymap dict.

    VS Code's keybindings.json is a JSON array of:
      { "key": "ctrl+shift+p", "command": "workbench.action.showCommands" }

    Entries with commands starting with "-" are removals — skip those.
    """
    try:
        raw = config_path.read_text(encoding="utf-8", errors="replace")

        # VS Code keybindings.json allows // comments — strip them
        raw = re.sub(r"//[^\n]*", "", raw)
        raw = re.sub(r"/\*.*?\*/", "", raw, flags=re.DOTALL)

        entries = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"  ✗ Failed to parse {config_path}: {e}", file=sys.stderr)
        return {}

    if not isinstance(entries, list):
        return {}

    shortcuts = []
    seen_keys: set[str] = set()

    for entry in entries:
        if not isinstance(entry, dict):
            continue

        command = entry.get("command", "")
        vsc_key  = entry.get("key", "")

        # Skip removal entries (command starts with -)
        if not command or command.startswith("-"):
            continue

        if not vsc_key:
            continue

        chord = vscode_key_to_chordmaster(vsc_key)
        if not chord:
            continue

        # Determine if it's a multi-chord sequence
        chords = [vscode_key_to_chordmaster(k) for k in vsc_key.split(" ") if k.strip()]
        chords = [c for c in chords if c]

        if len(chords) == 0:
            continue

        sc_type = "sequence" if len(chords) > 1 else "chord"
        keys = chords

        # Deduplicate
        key_sig = " ".join(keys)
        if key_sig in seen_keys:
            continue
        seen_keys.add(key_sig)

        description, difficulty = vscode_command_to_description(command)
        category = _vscode_category(command)

        # Safe ID from key combo
        safe_id = re.sub(r"[^a-z0-9]+", "-", chord.lower()).strip("-")
        shortcut_id = f"vsc-custom-{safe_id}"

        shortcuts.append({
            "id":          shortcut_id,
            "type":        sc_type,
            "keys":        keys,
            "description": description,
            "category":    category,
            "difficulty":  difficulty,
            "tags":        ["custom"],
        })

    return {
        "meta": {
            "id":          "vscode-custom",
            "name":        "VS Code (custom)",
            "subtitle":    "your keybindings",
            "icon":        "⬡",
            "color":       "#007acc",
            "version":     "1.0.0",
            "description": f"Custom VS Code keybindings parsed from {config_path}",
            "source":      str(config_path),
        },
        "shortcuts": shortcuts,
    }


# ── DISCOVERY + OUTPUT ───────────────────────────────────────────────────────

def find_config_file(source: str) -> Optional[Path]:
    """Return the first existing config file path for the given source."""
    for pattern in SEARCH_PATHS.get(source, []):
        path = Path(pattern).expanduser()
        if path.exists():
            return path
    return None


def discover_all() -> dict[str, Optional[Path]]:
    """Return a dict of source → config_path for all known sources."""
    return {source: find_config_file(source) for source in SEARCH_PATHS}


