def tmux_command_to_description(command_str: str) -> tuple[str, int]:
    """
    Parse a tmux command string and return (description, difficulty).

    Tries flag-specific lookup first, then generic command lookup,
    then falls back to a human-readable version of the raw string.
    """
    parts = command_str.strip().split()
    if not parts:
        return (command_str, 2)

    cmd = parts[0]
    flags = [p for p in parts[1:] if p.startswith("-")]

    # Flag-specific lookup (e.g. split-window -h vs split-window -v)
    for flag in flags:
        key = (cmd, flag)
        if key in TMUX_DESCRIPTIONS:
            return TMUX_DESCRIPTIONS[key]

    # Generic command lookup
    if (cmd, None) in TMUX_DESCRIPTIONS:
        return TMUX_DESCRIPTIONS[(cmd, None)]

    # Fallback: convert command name to readable string
    readable = cmd.replace("-", " ").title()
    return (readable, 2)


# ── TMUX — PARSER ────────────────────────────────────────────────────────────

# Matches:  bind [-n] [-T table] KEY COMMAND [ARGS...]
# Also:     bind-key [-n] [-T table] KEY COMMAND [ARGS...]
# -T takes a mandatory table argument — capture it as a pair so the
# table name is never mistaken for the key token.
_BIND_RE = re.compile(
    r"^\s*bind(?:-key)?"
    r"(?P<flags>(?:\s+(?:-T\s+\S+|-[^\s]+))*)"  # -T tablename captured as unit
    r"\s+(?P<key>\S+)"
    r"(?:\s+(?P<command>.+))?",
    re.MULTILINE
)

# Detect prefix override: set [-g] [-s] prefix C-a
_PREFIX_RE = re.compile(
    r"^\s*set(?:-option)?\s+(?:-[gs]\s+)*prefix\s+(?P<key>\S+)",
    re.MULTILINE
)


def parse_tmux(config_path: Path) -> dict:
    """
    Parse a tmux.conf file and return a chordmaster keymap dict.

    Handles:
    - Default prefix (ctrl+b) and custom prefix detection
    - bind KEY COMMAND  (prefix + key)
    - bind -n KEY COMMAND  (no prefix, direct chord)
    - bind -T TABLE KEY COMMAND  (table bindings — skip non-root tables)
    """
    text = config_path.read_text(encoding="utf-8", errors="replace")

    # Strip comments
    text = re.sub(r"#[^\n]*", "", text)

    # Join continuation lines
    text = re.sub(r"\\\n", " ", text)

    # Detect custom prefix (default: ctrl+b)
    prefix = "ctrl+b"
    prefix_match = _PREFIX_RE.search(text)
    if prefix_match:
        converted = tmux_key_to_chordmaster(prefix_match.group("key"))
        if converted:
            prefix = converted

    shortcuts = []
    seen_keys: set[str] = set()

    for match in _BIND_RE.finditer(text):
        flags_str = match.group("flags") or ""
        raw_key   = match.group("key") or ""
        command   = (match.group("command") or "").strip()

        if not raw_key or not command:
            continue

        # Parse flags — find -n and -T tablename
        flags = flags_str.split()
        no_prefix = "-n" in flags

        # Extract table name from "-T tablename" pair (captured as unit in regex)
        table_name = ""
        for i, f in enumerate(flags):
            if f == "-T" and i + 1 < len(flags):
                table_name = flags[i + 1]
                break

        # Only handle root table (default) and -n bindings
        if table_name and table_name.lower() not in ("root", ""):
            continue  # skip copy-mode, prefix table, etc.

        chord = tmux_key_to_chordmaster(raw_key)
        if not chord:
            continue

        if no_prefix:
            sc_type = "chord"
            keys = [chord]
        else:
            sc_type = "sequence"
            keys = [prefix, chord]

        description, difficulty = tmux_command_to_description(command)

        # Deduplicate by key combo
        key_sig = "+".join(keys)
        if key_sig in seen_keys:
            continue
        seen_keys.add(key_sig)

        # Derive category from command
        cmd_name = command.split()[0] if command else ""
        category = _tmux_category(cmd_name)

        shortcut_id = f"tmux-custom-{re.sub(r'[^a-z0-9]', '-', chord.lower())}"

        shortcuts.append({
            "id":          shortcut_id,
            "type":        sc_type,
            "keys":        keys,
            "description": description,
            "category":    category,
            "difficulty":  difficulty,
            "tags":        ["custom"],
        })

    return {
        "meta": {
            "id":          "tmux-custom",
            "name":        "tmux (custom)",
            "subtitle":    f"from {config_path.name}",
            "icon":        "⊞",
            "color":       "#00d4ff",
            "version":     "1.0.0",
            "description": f"Custom tmux bindings parsed from {config_path}",
            "source":      str(config_path),
        },
        "shortcuts": shortcuts,
    }


