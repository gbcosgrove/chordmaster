def tmux_key_to_chordmaster(tmux_key: str) -> Optional[str]:
    """
    Convert a tmux key binding string to chordmaster format.

    tmux format:       chordmaster format:
      C-a              ctrl+a
      M-f              alt+f
      C-M-x            ctrl+alt+x
      %                %
      Enter            enter
      F5               F5
    """
    key = tmux_key.strip()

    # Strip outer quotes if present
    key = key.strip("'\"")

    mods = []

    # Handle C- (Ctrl) prefix — may chain with M-
    while key.startswith("C-"):
        mods.append("ctrl")
        key = key[2:]

    # Handle M- (Meta/Alt) prefix
    while key.startswith("M-"):
        mods.append("alt")
        key = key[2:]

    # Handle S- (Shift) prefix — rare but valid
    while key.startswith("S-"):
        mods.append("shift")
        key = key[2:]

    # Nothing left
    if not key:
        return None

    # Special key names
    normalised = TMUX_SPECIAL_KEYS.get(key)
    if normalised:
        parts = mods + [normalised]
        return "+".join(parts)

    # Single printable character
    if len(key) == 1:
        parts = mods + [key]
        return "+".join(parts)

    # Function keys F1–F12
    if re.match(r"^F\d{1,2}$", key, re.IGNORECASE):
        parts = mods + [key.upper()]
        return "+".join(parts)

    # Unknown — pass through
    parts = mods + [key.lower()]
    return "+".join(parts)


