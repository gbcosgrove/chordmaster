# ── VSCODE — KEY NORMALISATION ───────────────────────────────────────────────

def vscode_key_to_chordmaster(vscode_key: str) -> Optional[str]:
    """
    Convert a VS Code key string to chordmaster format.

    VS Code:        chordmaster:
      ctrl+shift+p  ctrl+shift+p   (no change needed for most)
      cmd+s         meta+s
      alt+f4        alt+f4
      ctrl+k ctrl+s ctrl+k         (chord sequence — take first chord only for now)
    """
    if not vscode_key:
        return None

    # VS Code chord sequences (space-separated chords: "ctrl+k ctrl+s")
    # Only take the first chord for now — multi-chord is rare
    key = vscode_key.split(" ")[0].lower().strip()

    # Normalise modifier names
    key = key.replace("cmd+", "meta+")
    key = key.replace("win+", "meta+")

    # Filter out empty strings
    if not key:
        return None

    return key


