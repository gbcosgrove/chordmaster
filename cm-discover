    "vscode": parse_vscode,
}


def write_keymap(keymap: dict, out_dir: Path, dry_run: bool = False) -> Path:
    """Write a keymap dict as JSON to out_dir/{id}.json."""
    out_dir.mkdir(parents=True, exist_ok=True)
    filename = f"{keymap['meta']['id']}.json"
    out_path = out_dir / filename

    if not dry_run:
        out_path.write_text(json.dumps(keymap, indent=2, ensure_ascii=False))

    return out_path


# ── CLI ──────────────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="cm-discover",
        description="Generate ChordMaster keymaps from local config files.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        "--source", "-s",
        choices=list(SEARCH_PATHS.keys()),
        help="Only process this source (default: all)",
    )
    parser.add_argument(
        "--out", "-o",
        type=Path,
        default=Path("./keymaps"),
        metavar="DIR",
        help="Output directory for generated JSON files (default: ./keymaps)",
    )
    parser.add_argument(
        "--list", "-l",
        action="store_true",
        help="List discovered config files without generating keymaps",
    )
    parser.add_argument(
        "--dry-run", "-n",
        action="store_true",
        dest="dry_run",
        help="Parse and preview shortcut counts without writing files",
    )
    parser.add_argument(
        "--version", "-v",
        action="version",
        version=f"cm-discover {VERSION}",
    )

    args = parser.parse_args()

    sources_to_run = [args.source] if args.source else list(SEARCH_PATHS.keys())
    found = {s: find_config_file(s) for s in sources_to_run}

    # ── LIST mode ─────────────────────────────────────────────────────────────
    if args.list:
        print(f"\n  cm-discover {VERSION} — config file scan\n")
        for source, path in found.items():
            status = f"✓  {path}" if path else "✗  not found"
            searched = ", ".join(SEARCH_PATHS[source])
            print(f"  {source:<10} {status}")
            if not path:
                print(f"            searched: {searched}")
        print()
        return

    # ── PARSE + OUTPUT ────────────────────────────────────────────────────────
    any_found = False
    generated: list[tuple[str, Path]] = []

    for source, config_path in found.items():
        if not config_path:
            print(f"  {source:<10} ✗  no config file found")
            searched = ", ".join(SEARCH_PATHS[source])
            print(f"             searched: {searched}")
            continue

        any_found = True
        print(f"  {source:<10} ✓  {config_path}")

        try:
            keymap = PARSERS[source](config_path)
        except Exception as e:
            print(f"             ✗  parse error: {e}", file=sys.stderr)
            continue

        if not keymap or not keymap.get("shortcuts"):
            print(f"             ✗  no bindings found in {config_path.name}")
            continue

        count = len(keymap["shortcuts"])
        out_path = write_keymap(keymap, args.out, dry_run=args.dry_run)
        generated.append((source, out_path))

        prefix = "  (dry run)" if args.dry_run else "  →"
        print(f"             {prefix} {out_path}  ({count} shortcuts)")

    print()

    if not any_found:
        print("  No config files found. Nothing generated.\n")
        print("  Once you have tmux or VS Code configured, run cm-discover again.")
        print("  Run with --list to see which paths are searched.\n")
        return

    if generated and not args.dry_run:
        print(f"  Generated {len(generated)} keymap(s) in {args.out}/")
        print("  Import them in ChordMaster via the ↑ IMPORT KEYMAP button.\n")
    elif args.dry_run:
        print("  Dry run — no files written.\n")


if __name__ == "__main__":
    main()
